{
  "expo": {
    "name": "Kinsong Pets",
    "slug": "kinsong-pets",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "app.kinsong.pets",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.kinsong.pets"
        ]
      }
    },
    "android": {
      "package": "app.kinsong.pets"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "@bacons/apple-targets",
      "expo-asset",
      "./plugins/withoutPush"
    ]
  }
}
